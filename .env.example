# Copy to .env and fill in. The servers, the tools, the run scripts and compose.yaml read it from the project root.
# docs/server/settings.md lists every setting and its default. Letters and digits are safest in the passwords (they go into a URL).

# PostgreSQL, as the host sees it (compose.yaml maps the container's 5432 to 127.0.0.1:${PG_PORT}, 5433 by default).
# The user `shaiya` and the database `newshaiya` are the ones compose.yaml creates.
DATABASE_URL=postgres://shaiya:change-me@127.0.0.1:5433/newshaiya

# The password compose.yaml gives the PostgreSQL container: must equal the password in DATABASE_URL above.
PG_PASSWORD=change-me

# Only for importing the original game definitions (the SQL Server container, README step 4). At least 8 characters with
# upper case, lower case and a digit, or SQL Server refuses it.
MSSQL_SA_PASSWORD=Change-me-1234

# The folder holding the original SQL Server backups (PS_GameDefs and its neighbours), mounted read-only into the SQL Server
# container. tools/setup.sh sets it from its first argument.
# PSM_DATA_DIR=/path/to/PSM_Data

# Names and ports, with their defaults (change them only to run a second copy beside the first, and then all of them;
# PG_PORT must match the port in DATABASE_URL):
# PG_CONTAINER=newshaiya-postgres
# MSSQL_CONTAINER=newshaiya-mssql
# PG_PORT=5433
# MSSQL_PORT=14333
# PG_VOLUME=newshaiya-pgdata
# MSSQL_VOLUME=newshaiya-mssql-data
# docker compose's project name (default: the folder's name):
# COMPOSE_PROJECT_NAME=newshaiya
# How the import tools run psql: docker (inside PG_CONTAINER), host (the host's psql with DATABASE_URL), or auto (docker when the
# container is running, else host).
# NEWSHAIYA_PSQL=auto

# Examples of optional settings:
# GAME_SERVER_ID=1
# RUST_LOG=info
